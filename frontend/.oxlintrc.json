{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "warn"
  },
  "env": {
    "browser": true,
    "es2022": true
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-debugger": "error",
    "eqeqeq": "error",
    "no-console": "warn",
    "typescript/no-explicit-any": "warn",
    "typescript/no-unused-vars": "warn"
  },
  "ignorePatterns": ["dist", "coverage", "public/mockServiceWorker.js", "*.config.ts", "*.config.mjs"]
}