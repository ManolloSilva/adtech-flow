{
  "name": "adtech-flow-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "npm run lint:fast",
    "lint:fast": "oxlint --deny-warnings",
    "lint:fast:fix": "oxlint --fix",
    "lint:deep": "eslint . --max-warnings 0",
    "lint:deep:fix": "eslint . --fix",
    "lint:fix": "npm run lint:fast:fix && npm run lint:deep:fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.1.21",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-scroll-area": "^1.3.0",
    "@radix-ui/react-separator": "^1.1.16",
    "@radix-ui/react-slider": "^1.5.0",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@testing-library/dom": "^10.4.2",
    "@xyflow/react": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.0",
    "lucide-react": "^1.54.0",
    "msw": "^2.6.0",
    "nuqs": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.6.2",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.13",
    "globals": "^15.11.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^15.2.11",
    "oxlint": "^0.10.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.11.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint --fix --deny-warnings",
      "eslint --fix --max-warnings 0"
    ]
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
